  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     2 = max # of 1-3 neighbors
     4 = max # of 1-4 neighbors
    25 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.006 seconds
#read_restart restart.equil
change_box      all x final 0 80 y final 0 160 z final 0 90 remap
Changing box ...
  orthogonal box = (0 -220 -135) to (80 380 225)
  orthogonal box = (0 0 -135) to (80 160 225)
  orthogonal box = (0 0 0) to (80 160 90)

# ------------------- 3. Walls & Fluid Regions ----------------
lattice         fcc 4.0
Lattice spacing in x,y,z = 4 4 4

region          lower_wall block 0 80 0 160 0 10 units box
region          upper_wall block 0 80 0 160 80 90 units box
region          fluid_zone block 0 80 0 160 10.5 79.5 units box

create_atoms    1 region lower_wall units box
Created 9600 atoms
  using box units in orthogonal box = (0 0 0) to (80 160 90)
  create_atoms CPU = 0.001 seconds
create_atoms    2 region upper_wall units box
Created 8000 atoms
  using box units in orthogonal box = (0 0 0) to (80 160 90)
  create_atoms CPU = 0.003 seconds
create_atoms    11 random 6000 12345 fluid_zone units box
Created 6000 atoms
  using box units in orthogonal box = (0 0 0) to (80 160 90)
  create_atoms CPU = 0.000 seconds
create_atoms    4  random 500  6789  fluid_zone units box
Created 500 atoms
  using box units in orthogonal box = (0 0 0) to (80 160 90)
  create_atoms CPU = 0.000 seconds
create_atoms    6  random 100  54321 fluid_zone units box
Created 100 atoms
  using box units in orthogonal box = (0 0 0) to (80 160 90)
  create_atoms CPU = 0.000 seconds

# ------------------- 4. Masses -------------------------------
mass            1 40.078    # Calcium
mass            2 60.008    # Carbonate
mass            3 14.027    # Oil (CH2)
mass            4 14.027    # Surfactant
mass            5 14.027    # Extra Surfactant
mass            6 26.982    # Aluminum (NP)
mass            7 15.999    # Oxygen (NP)
mass            8 1.0
mass            9 1.0
mass            10 1.0
mass            11 15.999   # Water Oxygen
mass            12 1.008    # Water Hydrogen
mass            13 40.078   # Ca (High Salinity Ion)
mass            14 35.453   # Cl
mass            15 1.0
# ------------------- 5. Groups -------------------------------
group lower_wall type 1
9600 atoms in group lower_wall
group upper_wall type 2
8000 atoms in group upper_wall
group oil        type 3
1200 atoms in group oil
group surfactant type 4 5
500 atoms in group surfactant
group np         type 6 7
100 atoms in group np
group water      type 11 12
6000 atoms in group water
group mobile     subtract all lower_wall upper_wall
7800 atoms in group mobile

# ------------------- 6. Salinity Control ---------------------
variable frac1 equal ${wt}/100.0
variable frac1 equal 5.0/100.0
variable frac2 equal 2*${frac1}
variable frac2 equal 2*0.05

set group water type/fraction 13 ${frac1} 12345
set group water type/fraction 13 0.05 12345
Setting atom values ...
  305 settings made for type/fraction
set group water type/fraction 14 ${frac2} 67890
set group water type/fraction 14 0.1 67890
Setting atom values ...
  621 settings made for type/fraction

set type 13 charge  2.0
Setting atom values ...
  280 settings made for charge
set type 14 charge -1.0
Setting atom values ...
  621 settings made for charge

# ------------------- 7. Interactions -------------------------
pair_style      lj/cut/coul/long 10.0 12.0
kspace_style    pppm 1.0e-4
kspace_modify   slab 3.0 gewald 0.22

pair_coeff * * 0.1 3.5
pair_coeff 11 11 0.1553 3.166
pair_coeff 12 12 0.0    0.0
pair_coeff 13 13 0.1    2.8   # Ca-Ca
pair_coeff 14 14 0.15   4.4   # Cl-Cl

# --- Ion bridging innovation ---
pair_coeff 13 6 1.2 3.0       # جذب قوی کلسیم به نانوذره
pair_coeff 13 3 0.8 3.5       # جذب کلسیم به نفت
pair_coeff 14 6 0.1 3.2       # کلر به نانوذره (ضعیف - دافعه هم‌پوشانی)
pair_coeff 3  6 0.5 3.5       # Oil - Al(NP)

pair_modify mix arithmetic

bond_coeff  1 250.0 1.54
angle_coeff 1 60.0 109.5

# ------------------- Restart Management ---------------------
# Write restart files every 50,000 steps for safe continuation
restart         50000 restart.equil restart.flow

# If a restart file exists, uncomment the following lines
# and comment out the read_data command above
#
# variable rst file restart.equil
# if "${rst}" == "restart.equil" then "read_restart restart.equil"


# ------------------- 8. Run Phases ---------------------------
include in.equilibration
# ============================================================
# in.equilibration
# Equilibrium phase (NVT, no external driving force)
# ============================================================

print ">>> Starting Equilibration Phase (NVT, equilibrium properties)"
>>> Starting Equilibration Phase (NVT, equilibrium properties)

# ------------------------------------------------------------
# 1. Density profile (equilibrium)
# ------------------------------------------------------------
compute c_dens all chunk/atom bin/1d z lower 0.2 units box
fix f_dens all ave/chunk 10 1000 10000 c_dens density/mass file density_${ion}_${wt}_${T}_${push_force}.dat
fix f_dens all ave/chunk 10 1000 10000 c_dens density/mass file density_Ca_${wt}_${T}_${push_force}.dat
fix f_dens all ave/chunk 10 1000 10000 c_dens density/mass file density_Ca_5.0_${T}_${push_force}.dat
fix f_dens all ave/chunk 10 1000 10000 c_dens density/mass file density_Ca_5.0_350_${push_force}.dat
fix f_dens all ave/chunk 10 1000 10000 c_dens density/mass file density_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 2. RDFs (structural analysis at equilibrium)
# ------------------------------------------------------------
compute rdf_np_ca all rdf 200 6 13
compute rdf_oil_water all rdf 200 3 11
compute rdf_surf_oil all rdf 200 4 3

fix frdf all ave/time 100 1 100 c_rdf_np_ca[*] c_rdf_oil_water[*] c_rdf_surf_oil[*] file rdf_all_${ion}_${wt}_${T}_${push_force}.dat mode vector
fix frdf all ave/time 100 1 100 c_rdf_np_ca[*] c_rdf_oil_water[*] c_rdf_surf_oil[*] file rdf_all_Ca_${wt}_${T}_${push_force}.dat mode vector
fix frdf all ave/time 100 1 100 c_rdf_np_ca[*] c_rdf_oil_water[*] c_rdf_surf_oil[*] file rdf_all_Ca_5.0_${T}_${push_force}.dat mode vector
fix frdf all ave/time 100 1 100 c_rdf_np_ca[*] c_rdf_oil_water[*] c_rdf_surf_oil[*] file rdf_all_Ca_5.0_350_${push_force}.dat mode vector
fix frdf all ave/time 100 1 100 c_rdf_np_ca[*] c_rdf_oil_water[*] c_rdf_surf_oil[*] file rdf_all_Ca_5.0_350_0.4.dat mode vector

# ------------------------------------------------------------
# 3. Mean Square Displacement (equilibrium diffusion)
# ------------------------------------------------------------
compute c_msd oil msd
fix f_msd all ave/time 100 10 1000 c_c_msd[4] file msd_oil_${ion}_${wt}_${T}_${push_force}.dat
fix f_msd all ave/time 100 10 1000 c_c_msd[4] file msd_oil_Ca_${wt}_${T}_${push_force}.dat
fix f_msd all ave/time 100 10 1000 c_c_msd[4] file msd_oil_Ca_5.0_${T}_${push_force}.dat
fix f_msd all ave/time 100 10 1000 c_c_msd[4] file msd_oil_Ca_5.0_350_${push_force}.dat
fix f_msd all ave/time 100 10 1000 c_c_msd[4] file msd_oil_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 4. Center of Mass of oil (reference state for RF)
# ------------------------------------------------------------
compute c_com oil com
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_eq_${ion}_${wt}_${T}_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_eq_Ca_${wt}_${T}_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_eq_Ca_5.0_${T}_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_eq_Ca_5.0_350_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_eq_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 5. Interfacial Tension (equilibrium definition)
# ------------------------------------------------------------
variable IFT equal 0.5*lz*(pzz-0.5*(pxx+pyy))*0.101325
fix f_ift all ave/time 100 10 1000 v_IFT file ift_${ion}_${wt}_${T}_${push_force}.dat
fix f_ift all ave/time 100 10 1000 v_IFT file ift_Ca_${wt}_${T}_${push_force}.dat
fix f_ift all ave/time 100 10 1000 v_IFT file ift_Ca_5.0_${T}_${push_force}.dat
fix f_ift all ave/time 100 10 1000 v_IFT file ift_Ca_5.0_350_${push_force}.dat
fix f_ift all ave/time 100 10 1000 v_IFT file ift_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 6. Thermodynamic output
# ------------------------------------------------------------
thermo_style custom step temp press v_IFT
thermo 1000

# ------------------------------------------------------------
# 7. Wall constraints
# ------------------------------------------------------------
fix f_freeze_low lower_wall setforce 0.0 0.0 0.0
fix f_freeze_up  upper_wall setforce 0.0 0.0 0.0

# ------------------------------------------------------------
# 8. Gentle start (remove bad contacts)
# ------------------------------------------------------------
fix f_lim mobile nve/limit 0.1
run 5000

