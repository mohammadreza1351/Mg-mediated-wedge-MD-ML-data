print ">>> Equilibration completed"
>>> Equilibration completed
include in.flow
# ============================================================
# in.flow
# Non-equilibrium flow phase (NVT + body force in y)
# ============================================================

print ">>> Starting Flow Phase - Applying Body Force in y-direction"
>>> Starting Flow Phase - Applying Body Force in y-direction

# --- Cleanup in case of re-inclusion ---
uncompute c_dens
unfix f_dens

uncompute rdf_np_ca
uncompute rdf_oil_water
uncompute rdf_surf_oil
unfix frdf

uncompute c_msd
unfix f_msd

uncompute c_com
unfix f_com

unfix f_ift
# ------------------------------------------------------------
# 1. External driving force (pressure-gradient equivalent)
# ------------------------------------------------------------
variable Fpush equal ${push_force}
variable Fpush equal 0.4
fix push mobile addforce 0.0 v_Fpush 0.0

# ------------------------------------------------------------
# 2. Velocity profile (for Poiseuille / viscosity)
# ------------------------------------------------------------
compute c_flow mobile chunk/atom bin/1d z lower 0.5 units box
fix f_vel all ave/chunk 10 1000 10000 c_flow vy file vel_profile_${ion}_${wt}_${T}_${push_force}.dat
fix f_vel all ave/chunk 10 1000 10000 c_flow vy file vel_profile_Ca_${wt}_${T}_${push_force}.dat
fix f_vel all ave/chunk 10 1000 10000 c_flow vy file vel_profile_Ca_5.0_${T}_${push_force}.dat
fix f_vel all ave/chunk 10 1000 10000 c_flow vy file vel_profile_Ca_5.0_350_${push_force}.dat
fix f_vel all ave/chunk 10 1000 10000 c_flow vy file vel_profile_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 3. Shear stress (non-equilibrium)
# ------------------------------------------------------------
variable shear_stress equal -pxy
fix f_shear all ave/time 100 10 1000 v_shear_stress file shear_${ion}_${wt}_${T}_${push_force}.dat
fix f_shear all ave/time 100 10 1000 v_shear_stress file shear_Ca_${wt}_${T}_${push_force}.dat
fix f_shear all ave/time 100 10 1000 v_shear_stress file shear_Ca_5.0_${T}_${push_force}.dat
fix f_shear all ave/time 100 10 1000 v_shear_stress file shear_Ca_5.0_350_${push_force}.dat
fix f_shear all ave/time 100 10 1000 v_shear_stress file shear_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 4. Apparent viscosity (instantaneous definition)
# (Used only for monitoring; final viscosity from post-processing)
# ------------------------------------------------------------
variable shear_rate equal 0.001   # reference value (post-processing refined)
variable eta equal v_shear_stress/v_shear_rate
fix f_eta all ave/time 100 10 1000 v_eta file viscosity_monitor_${ion}_${wt}_${T}_${push_force}.dat
fix f_eta all ave/time 100 10 1000 v_eta file viscosity_monitor_Ca_${wt}_${T}_${push_force}.dat
fix f_eta all ave/time 100 10 1000 v_eta file viscosity_monitor_Ca_5.0_${T}_${push_force}.dat
fix f_eta all ave/time 100 10 1000 v_eta file viscosity_monitor_Ca_5.0_350_${push_force}.dat
fix f_eta all ave/time 100 10 1000 v_eta file viscosity_monitor_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 5. Center of Mass of oil (for Recovery Factor)
# ------------------------------------------------------------
compute c_com oil com
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_flow_${ion}_${wt}_${T}_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_flow_Ca_${wt}_${T}_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_flow_Ca_5.0_${T}_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_flow_Ca_5.0_350_${push_force}.dat
fix f_com all ave/time 100 10 1000 c_c_com[2] file com_oil_flow_Ca_5.0_350_0.4.dat

# ------------------------------------------------------------
# 6. Thermodynamic output
# ------------------------------------------------------------
thermo_style custom step temp press v_IFT v_shear_stress v_Fpush
thermo 1000

# ------------------------------------------------------------
# 7. Trajectory output
# ------------------------------------------------------------
dump d_movie all custom 5000 eor_${ion}_${wt}_${T}_${push_force}.lammpstrj id type x y z
dump d_movie all custom 5000 eor_Ca_${wt}_${T}_${push_force}.lammpstrj id type x y z
dump d_movie all custom 5000 eor_Ca_5.0_${T}_${push_force}.lammpstrj id type x y z
dump d_movie all custom 5000 eor_Ca_5.0_350_${push_force}.lammpstrj id type x y z
dump d_movie all custom 5000 eor_Ca_5.0_350_0.4.lammpstrj id type x y z

# ------------------------------------------------------------
# 8. Flow run
# ------------------------------------------------------------
run 1000000
